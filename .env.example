# Next.js server; copy to .env.local. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=
# Public browser key, used only to subscribe to a one-row dashboard update signal.
# Prefer a publishable key (sb_publishable_...); never use a secret/service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Prefer the new server-side Secret Key. Either this or service_role is required.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEEPSEEK_API_KEY=
# Current DeepSeek model; can be changed without changing application code.
DEEPSEEK_MODEL=deepseek-flash
# Generate a random secret of at least 32 characters. Match Supabase Vault.
CRON_SECRET=
# Confirmed single monitored account.
TIBO_X_URL=https://x.com/thsottiaux
# Public HTTPS origin of the independent Python container.
# Local development: http://127.0.0.1:8000
SCRAPER_URL=
# Another random secret of at least 32 characters, shared with the container.
SCRAPER_SECRET=
